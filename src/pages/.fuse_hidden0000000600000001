function Hero() {
  const { t } = useLang();
  const reduce = useReducedMotion();
  const ref = useRef(null);
  const { scrollYProgress } = useScroll({ target: ref, offset: ["start start", "end start"] });
  const y = useTransform(scrollYProgress, [0, 1], [0, reduce ? 0 : 60]);

  const words = t.home.heroTitle.split(" ");

  const container = { hidden: {}, show: { transition: { staggerChildren: 0.06, delayChildren: 0.1 } } };
  const item = {
    hidden: reduce ? { opacity: 0 } : { opacity: 0, y: 24 },
    show: { opacity: 1, y: 0, transition: { duration: 0.5, ease: "easeOut" } },
  };

  return (
    <section ref={ref} className="grain relative overflow-hidden bg-cream">
      <div className="mx-auto grid max-w-[1200px] items-center gap-10 px-5 pb-8 pt-12 md:pt-20 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
        <motion.div variants={container} initial="hidden" animate="show" className="text-center lg:text-start">
          <motion.p variants={item} className="eyebrow text-maroon">
            {t.home.heroEyebrow}
          </motion.p>
          <h1 className="mt-4 font-display text-[clamp(2.4rem,6vw,4.4rem)] font-semibold leading-[1.08] text-ink">
            {words.map((w, i) => (
              <motion.span key={i} variants={item} className="inline-block ltr:mr-[0.25em] rtl:ml-[0.25em]">
                {w}
              </motion.span>
            ))}
          </h1>
          <motion.p variants={item} className="prose-col mx-auto mt-6 font-body text-[18px] leading-relaxed text-muted lg:mx-0">
            {t.home.heroSub}
          </motion.p>
          <motion.div variants={item} className="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
            <DonateButton>{t.common.donateNow}</DonateButton>
            <OutlineButton to="/appointment">{t.common.bookAppointment}</OutlineButton>
          </motion.div>
        </motion.div>

        <motion.div style={{ y }} className="relative">
          <div className="absolute -inset-3 -z-0 hidden rounded-2xl bg-sagetint sm:block ltr:translate-x-4 ltr:translate-y-4 rtl:-translate-x-4 rtl:translate-y-4" aria-hidden="true" />
          <motion.div
            initial={reduce ? { opacity: 0 } : { opacity: 0, scale: 0.97 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ duration: 0.8, ease: "easeOut", delay: 0.35 }}
            className="relative"
          >
            <ImageSlot
              src="hero-building.jpg"
              ratio="4/3"
              alt="Hamza Welfare Hospital building exterior on Simly Dam Road, Pind Begwal, near Islamabad"
              rounded="rounded-2xl"
            />
          </motion.div>
        </motion.div>
      </div>
    </section>
  );
}

function Stats() {
  const { t } = useLang();
  const h = t.home;
  const stats = [
    { num: h.stat1Num, suffix: h.stat1Suffix, label: h.stat1Label },
    { num: h.stat2Num, suffix: h.stat2Suffix, label: h.stat2Label },
    { num: h.stat3Num, suffix: h.stat3Suffix, label: h.stat3Label },
    { num: h.stat4Num, suffix: h.stat4Suffix, prefix: h.stat4Prefix, label: h.stat4Label },
  ];
  return (
    <section className="grain bg-cream2">
      <div className="mx-auto max-w-[1100px] px-5 py-16 md:py-20">
        <div className="grid grid-cols-2 gap-y-10 lg:grid-cols-4 lg:divide-x lg:divide-hair rtl:lg:divide-x-reverse">
          {stats.map((s, i) => (
            <Reveal key={i} delay={i * 0.08} className="px-4 text-center">
              <div className="font-display text-[clamp(2rem,4.2vw,2.9rem)] font-medium leading-none tracking-tight text-forest">
                <CountUp value={s.num} prefix={s.prefix || ""} suffix={s.suffix || ""} />
              </div>
              <div className="mx-auto mt-2.5 h-[2px] w-9 bg-maroon" />
              <p className="mx-auto mt-2.5 max-w-[15ch] font-body text-[13.5px] leading-snug text-muted">{s.label}</p>
            </Reveal>
          ))}
        </div>
        <p className="mt-10 text-center font-body text-[12.5px] italic text-muted/90">{h.statsCaption}</p>
      </div>
    </section>
  );
}

// Split-section heading column: heading is centered within its own half,
// sitting opposite the body/content column. Stacks cleanly on mobile.
function SectionHeading({ eyebrow, eyebrowTone = "sage", title, body, cta, children, align = "center" }) {
  return (
    <div className={`flex h-full flex-col justify-center ${align === "center" ? "text-center" : ""}`}>
      <Reveal>
        {eyebrow && <Eyebrow tone={eyebrowTone}>{eyebrow}</Eyebrow>}
        <h2 className="mt-4 font-display text-[clamp(1.9rem,4vw,2.8rem)] font-semibold leading-tight text-ink">
          {title}
        </h2>
        {body && <p className="prose-col mx-auto mt-5 font-body text-muted">{body}</p>}
        {children}
        {cta}
      </Reveal>
    </div>
  );
}

